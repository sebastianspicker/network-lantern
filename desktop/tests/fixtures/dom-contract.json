{
  "markup": "<a class=\"skip-link\" href=\"#content\">Skip to workspace</a><header class=\"masthead\"><h1 class=\"brand\"><svg class=\"mark\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path class=\"mark-body\" d=\"M11 10h10l2 16H9l2-16Zm2 0V7a3 3 0 0 1 6 0v3M12 13h8M8 26h16\"></path><path class=\"mark-flame\" d=\"M16 15.5c-3.4 3.4-2.6 6 0 6s3.4-2.6 0-6Z\"></path></svg><span>Network Lantern</span></h1><div class=\"runtime\"><span id=\"environment\" data-state=\"unavailable\">Runtime unavailable</span><button id=\"refresh-runtime\" class=\"quiet compact\">Check runtime</button></div></header><div class=\"frame\"><nav class=\"rail\" aria-label=\"Workflows\"><div class=\"rail-group\" role=\"group\" aria-labelledby=\"rail-measure\"><p class=\"rail-label\" id=\"rail-measure\">Measure</p><button data-flow=\"triage\" aria-current=\"page\"><strong>Triage</strong><span>Path, then throughput</span></button><button data-flow=\"path\" aria-current=\"false\"><strong>Path</strong><span>Reachability and routing</span></button><button data-flow=\"throughput\" aria-current=\"false\"><strong>Throughput</strong><span>iperf3 test matrix</span></button><button data-flow=\"baseline\" aria-current=\"false\"><strong>Baseline</strong><span>Path and one sample</span></button></div><div class=\"rail-group\" role=\"group\" aria-labelledby=\"rail-change\"><p class=\"rail-label\" id=\"rail-change\">Change</p><button data-flow=\"windows_tuning\" aria-current=\"false\"><strong>Windows tuning</strong><span>Verify, back up, apply, restore</span></button></div><div class=\"rail-group\" role=\"group\" aria-labelledby=\"rail-records\"><p class=\"rail-label\" id=\"rail-records\">Records</p><button data-flow=\"profiles\" aria-current=\"false\"><strong>Profiles</strong><span>Saved configurations</span></button><button data-flow=\"reports\" aria-current=\"false\"><strong>Reports</strong><span>Recorded evidence</span></button></div></nav><aside class=\"system\" aria-label=\"Runtime\"><details class=\"helper-panel\"><summary>Privileged helper</summary><p>Needed for native probes and Windows changes. Your operating system asks for approval.</p><p id=\"helper-detail\" class=\"data\" role=\"status\">Helper status unavailable while the native runtime is disconnected.</p><div class=\"actions\"><button id=\"helper-register\" class=\"secondary compact\" disabled=\"\">Register</button><button id=\"helper-remove\" class=\"danger compact\" disabled=\"\">Remove</button></div></details><p class=\"system-note\">Runs locally. One measurement at a time. Every run starts from a reviewed plan.</p></aside><main class=\"desk\"><div id=\"runtime-notice\" class=\"notice\" role=\"status\" data-tone=\"alert\">Native runtime unavailable. Open the Network Lantern desktop application to use this operation.</div><section id=\"run-strip\" class=\"run-strip\" aria-label=\"Active measurement\" hidden=\"\"><span class=\"lamp-indicator\" aria-hidden=\"true\"></span><div class=\"run-head\"><strong id=\"run-title\" role=\"status\"></strong><p id=\"run-count\"></p></div><progress id=\"run-progress\"></progress><div class=\"run-actions\"><button id=\"cancel\" class=\"danger\">Cancel run</button><button id=\"open-run\" class=\"secondary\" hidden=\"\">Open report</button></div><details class=\"run-log\"><summary>Recent activity</summary><pre id=\"run-logs\" tabindex=\"0\"></pre></details><p id=\"run-error\" class=\"error\" role=\"alert\"></p></section><section id=\"content\" tabindex=\"-1\"><div id=\"measurement\" data-stage=\"configure\"><div class=\"flow-head\"><h2 id=\"flow-title\">Triage</h2><p id=\"flow-description\" class=\"lede\">Trace the route to a host, then measure throughput against an iperf3 server you control.</p></div><div class=\"controls\"><form id=\"configuration\"><fieldset id=\"path-fields\"><legend>Path diagnostics</legend><label class=\"field\" for=\"host\"><span>Host</span><input id=\"host\" type=\"text\" value=\"\" placeholder=\"host.example.net\" autocomplete=\"off\" spellcheck=\"false\" maxlength=\"253\"></label><div class=\"two\"><label class=\"field\" for=\"family\"><span>Address family</span><select id=\"family\"><option>IPv4</option><option>IPv6</option></select></label><label class=\"field\" for=\"round\"><span>Round</span><select id=\"round\"><option>Standard</option><option>MTU1400_DF</option><option>TTL64_Timeout5s</option></select></label></div><div id=\"engine-fields\" hidden=\"\"><label class=\"field\" for=\"engine\"><span>Engine</span><select id=\"engine\"><option value=\"path_basic\">Basic path diagnostics</option><option value=\"path_trace\">Continuous path trace</option></select></label><label class=\"field\" for=\"trace-type\"><span>Trace mode</span><select id=\"trace-type\" disabled=\"\"><option>ICMP4</option><option>TCP4</option><option>UDP4</option><option>MPLS4</option><option>AS4</option></select></label><p class=\"hint\">AS mode sends hop addresses to Team Cymru DNS to look up their networks.</p></div><label class=\"check\"><input id=\"skip\" type=\"checkbox\">Skip pathping</label></fieldset><fieldset id=\"throughput-fields\"><legend>Throughput</legend><label class=\"field\" for=\"target\"><span>Server</span><input id=\"target\" type=\"text\" value=\"\" placeholder=\"iperf.example.net\" autocomplete=\"off\" spellcheck=\"false\" maxlength=\"253\"></label><div class=\"two\"><label class=\"field\" for=\"port\"><span>Port</span><input id=\"port\" type=\"number\" value=\"5201\" min=\"1\" max=\"65535\" required=\"\"></label><label class=\"field\" for=\"protocol\"><span>Protocol</span><select id=\"protocol\"><option>Both</option><option>TCP</option><option>UDP</option></select></label></div><label class=\"field\" for=\"max-tests\"><span>Maximum tests</span><input id=\"max-tests\" type=\"number\" value=\"0\" min=\"0\" max=\"1000000\" required=\"\"></label><p class=\"hint\">0 means no limit. The default matrix plans up to 1,145 tests, so set a limit on shared links.</p></fieldset><fieldset id=\"tuning-fields\" hidden=\"\" disabled=\"\"><legend>Windows tuning</legend><div class=\"two\"><label class=\"field\" for=\"action\"><span>Action</span><select id=\"action\"><option>Verify</option><option>Backup</option><option>Apply</option><option>Restore</option></select></label><label class=\"field\" for=\"tuning-profile\"><span>Profile</span><select id=\"tuning-profile\"><option>Safe</option><option>Measured</option></select></label></div><label class=\"field\" for=\"udp-port\"><span>Managed UDP port</span><input id=\"udp-port\" type=\"number\" value=\"5201\" min=\"1\" max=\"65535\" required=\"\"></label><label class=\"field\" for=\"dscp\"><span>DSCP</span><input id=\"dscp\" type=\"number\" value=\"46\" min=\"0\" max=\"63\" required=\"\"></label><label class=\"field\" for=\"backup-folder\"><span>Backup / restore folder</span><input id=\"backup-folder\" type=\"text\" value=\"\" placeholder=\"Default protected backup location\"></label><label class=\"field\" for=\"power-plan\"><span>Power plan</span><select id=\"power-plan\"><option>None</option><option>HighPerformance</option></select></label><label class=\"check\"><input id=\"app-policies\" type=\"checkbox\">Manage application QoS policies</label><label class=\"field\" for=\"app-paths\"><span>Application paths, one per line</span><textarea id=\"app-paths\" rows=\"3\" spellcheck=\"false\"></textarea></label><p class=\"hint\">Apply and Restore change Windows. Keep a backup and an independent way back before you start.</p></fieldset><details class=\"advanced\"><summary>Additional settings</summary><label class=\"field\" for=\"advanced\"><span>JSON override layer</span><textarea id=\"advanced\" rows=\"6\" spellcheck=\"false\">{}</textarea></label><p class=\"hint\">Applied last, on top of the fields above. Rust validates every key; loaded profiles land here.</p><label class=\"check\"><input id=\"strict\" type=\"checkbox\">Reject unknown settings</label></details><label class=\"field\" for=\"out\"><span>Results directory</span><input id=\"out\" type=\"text\" value=\"results\" required=\"\"></label><div class=\"actions\"><button id=\"preview\" type=\"submit\" disabled=\"\">Review plan</button><button id=\"save-config\" type=\"button\" class=\"secondary\">Save as profile</button></div></form></div><section class=\"preview\" aria-labelledby=\"preview-title\"><div class=\"preview-head\"><h2 id=\"preview-title\">Plan</h2><ol class=\"lifecycle\" aria-hidden=\"true\"><li>Configure</li><li>Review</li><li>Run</li></ol></div><p id=\"capability\" class=\"capability\" data-available=\"false\">Native runtime unavailable. Open the desktop application.</p><p id=\"plan-state\" role=\"status\">Configure your workflow and review its plan.</p><div id=\"plan-error\" class=\"error\" role=\"alert\"></div><div id=\"plan-summary\"></div><details id=\"plan-details\" hidden=\"\"><summary>Resolved plan (JSON)</summary><pre id=\"plan-json\" tabindex=\"0\"></pre></details><div class=\"start-area\"><button id=\"start\" class=\"lamp\" disabled=\"\">Start reviewed run</button><p class=\"hint\">Starting sends network traffic or performs the selected tuning action.</p></div></section></div><section id=\"profiles\" class=\"library\" hidden=\"\"><div class=\"flow-head\"><h2>Profiles</h2><p class=\"lede\">Settings you reuse, kept in a local store. A loaded profile still needs a fresh plan.</p></div><div class=\"source-row\"><label class=\"field\" for=\"store\"><span>Profile store</span><input id=\"store\" type=\"text\" value=\".iperf3/profiles.json\"></label><button id=\"load-profiles\" class=\"secondary\">Refresh profiles</button></div><p id=\"profiles-status\" class=\"library-status\" role=\"status\"></p><div class=\"library-grid\"><div class=\"index-column\"><h3>Saved profiles</h3><ul id=\"profile-list\" class=\"item-list\"></ul></div><form id=\"profile-form\"><label class=\"field\" for=\"profile-name\"><span>Name</span><input id=\"profile-name\" type=\"text\" value=\"\" required=\"\" maxlength=\"128\"></label><label class=\"field\" for=\"profile-flow\"><span>Load into workflow</span><select id=\"profile-flow\"><option value=\"triage\">Triage</option><option value=\"path\">Path</option><option value=\"throughput\">Throughput</option><option value=\"baseline\">Baseline</option><option value=\"windows_tuning\">Windows tuning</option></select></label><label class=\"field\" for=\"profile-json\"><span id=\"profile-json-label\">Parameters (JSON object)</span><textarea id=\"profile-json\" rows=\"12\" spellcheck=\"false\">{}</textarea></label><div class=\"actions\"><button type=\"submit\">Save profile</button><button id=\"use-profile\" type=\"button\" class=\"secondary\">Load into workflow</button><button id=\"delete-profile\" type=\"button\" class=\"danger\">Delete</button></div><p id=\"delete-confirm\" class=\"confirm\" hidden=\"\"><span>Delete this saved profile? This cannot be undone.</span><button type=\"button\" id=\"confirm-delete\" class=\"danger\">Confirm deletion</button><button type=\"button\" id=\"keep-profile\" class=\"secondary\">Keep profile</button></p></form></div></section><section id=\"reports\" class=\"library\" hidden=\"\"><div class=\"flow-head\"><h2>Reports</h2><p class=\"lede\">Runs recorded in a results directory. Page through measurements, compare with a baseline, or export. Missing metrics stay marked unavailable.</p></div><div class=\"source-row\"><label class=\"field\" for=\"report-directory\"><span>Results directory</span><input id=\"report-directory\" type=\"text\" value=\"results\"></label><button id=\"refresh-reports\" class=\"secondary\">Refresh runs</button></div><div class=\"source-row\"><label class=\"field\" for=\"report-path\"><span>Report path</span><input id=\"report-path\" type=\"text\" value=\"\" placeholder=\"results/run-id/summary.json\"></label><button id=\"read-report\" class=\"secondary\">Open report</button></div><p id=\"reports-status\" class=\"library-status\" role=\"status\"></p><div class=\"table-scroll\"><table class=\"ledger\"><thead><tr><th scope=\"col\">Run</th><th scope=\"col\">Status</th><th scope=\"col\" class=\"figure\">Measurements</th><th scope=\"col\"><span class=\"visually-hidden\">Action</span></th></tr></thead><tbody id=\"run-list\"></tbody></table></div><div class=\"actions\"><button id=\"runs-prev\" class=\"secondary compact\">Previous runs</button><button id=\"runs-next\" class=\"secondary compact\">Next runs</button><span id=\"runs-page\" class=\"page-label\"></span></div><section id=\"report-detail\" hidden=\"\"><h3>Selected report</h3><div id=\"report-metadata\"></div><div class=\"actions\"><button id=\"rows-prev\" class=\"secondary compact\">Previous measurements</button><button id=\"rows-next\" class=\"secondary compact\">Next measurements</button><span id=\"rows-page\" class=\"page-label\"></span></div><pre id=\"report-rows\" class=\"record\" tabindex=\"0\"></pre><h3>Compare and export</h3><div class=\"two\"><label class=\"field\" for=\"baseline-path\"><span>Baseline report path</span><input id=\"baseline-path\" type=\"text\" value=\"\"></label><label class=\"field\" for=\"export-path\"><span>Export destination</span><input id=\"export-path\" type=\"text\" value=\"\" placeholder=\"exports/review.json\"></label></div><div class=\"actions\"><button id=\"compare\" class=\"secondary\">Compare with baseline</button><button id=\"export\" class=\"secondary\">Export JSON</button></div><pre id=\"comparison\" class=\"record\" tabindex=\"0\" hidden=\"\"></pre></section></section></section></main></div>",
